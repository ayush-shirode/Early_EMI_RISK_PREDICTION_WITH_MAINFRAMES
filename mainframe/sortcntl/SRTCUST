* SRTCUST - ICETOOL: SORT THE CUSTOMER MASTER BY CUSTOMER ID AND
*           DROP DUPLICATE IDS. FIRST KEEPS THE FIRST RECORD OF EACH
*           ID IN INPUT ORDER; DISCARD WRITES THE DROPPED DUPLICATES
*           TO DD DUPS (EWS.CUST.DUPS) SO THEY CAN BE RECONCILED.
  SELECT FROM(IN) TO(OUT) ON(1,8,CH) FIRST DISCARD(DUPS)
