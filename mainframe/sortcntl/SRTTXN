* SRTTXN - SORT MONTHLY ACCOUNT SUMMARIES BY CUSTOMER, MONTH AND
*          SPLIT OUT RECORDS WITH A NON-NUMERIC FIELD.
*   SORTOUT : GOOD RECORDS                     (EWS.TXN.SRT)
*   BADREC  : REJREC FORMAT, REASON S02        (EWS.REJECTS, MOD)
*   CHECKED : YYYYMM 9,6  CREDITS 15,9  DEBITS 24,9  SALARY 33,9
*             MIN-BAL 42,9  AVG-BAL 51,9  BOUNCES 60,2  CC-UTIL 62,5
  SORT FIELDS=(1,8,CH,A,9,6,CH,A)
  OUTFIL FNAMES=SORTOUT,
    INCLUDE=(9,6,ZD,EQ,NUM,AND,15,9,ZD,EQ,NUM,AND,24,9,ZD,EQ,NUM,AND,
             33,9,ZD,EQ,NUM,AND,42,9,ZD,EQ,NUM,AND,51,9,ZD,EQ,NUM,AND,
             60,2,ZD,EQ,NUM,AND,62,5,ZD,EQ,NUM)
  OUTFIL FNAMES=BADREC,
    OMIT=(9,6,ZD,EQ,NUM,AND,15,9,ZD,EQ,NUM,AND,24,9,ZD,EQ,NUM,AND,
          33,9,ZD,EQ,NUM,AND,42,9,ZD,EQ,NUM,AND,51,9,ZD,EQ,NUM,AND,
          60,2,ZD,EQ,NUM,AND,62,5,ZD,EQ,NUM),
    BUILD=(C'TXNSUMM ',1,8,2X,C'S02 ',
           C'NON-NUMERIC FIELD IN ACCOUNT SUMMARY',4X,1,58)
