* SRTREPAY - SORT REPAYMENTS BY CUSTOMER, LOAN, DUE DATE AND SPLIT
*            OUT RECORDS WITH A NON-NUMERIC FIELD.
*   SORTOUT : GOOD RECORDS                     (EWS.REPAY.SRT)
*   BADREC  : REJREC FORMAT, REASON S01        (EWS.REJECTS, MOD)
*   CHECKED : INST-NO 19,3  DUE 22,8  PAID 30,8  DUE-AMT 38,9
*             PAID-AMT 47,9  DPD 56,3
  SORT FIELDS=(11,8,CH,A,1,10,CH,A,22,8,CH,A)
  OUTFIL FNAMES=SORTOUT,
    INCLUDE=(19,3,ZD,EQ,NUM,AND,22,8,ZD,EQ,NUM,AND,30,8,ZD,EQ,NUM,AND,
             38,9,ZD,EQ,NUM,AND,47,9,ZD,EQ,NUM,AND,56,3,ZD,EQ,NUM)
  OUTFIL FNAMES=BADREC,
    OMIT=(19,3,ZD,EQ,NUM,AND,22,8,ZD,EQ,NUM,AND,30,8,ZD,EQ,NUM,AND,
          38,9,ZD,EQ,NUM,AND,47,9,ZD,EQ,NUM,AND,56,3,ZD,EQ,NUM),
    BUILD=(C'REPAYHST',1,10,C'S01 ',
           C'NON-NUMERIC FIELD IN REPAYMENT',10X,1,58)
