//EWSBATCH JOB CLASS=7,MSGLEVEL=(1,1)
//*-------------------------------------------------------------------
//* EWSBATCH - EARLY WARNING SYSTEM: PREPARE ML FEATURES
//*
//*  SYMBOLS (PASSED BY THE BACKEND WITH ZOWE --jcl-symbols):
//*    ASOFDT  AS-OF DATE YYYYMMDD
//*    MODE    SCORE (FEATURES ONLY) OR TRAIN (FEATURES + LABEL)
//*
//*  STEP005  IEFBR14   DELETE OUTPUT OF THE PREVIOUS RUN
//*  STEP006  IEFBR14   ALLOCATE REJECTS AND CTLTOT (SHARED, DISP=MOD)
//*  STEP010  ICETOOL   SORT CUSTOMERS, DROP DUPLICATE IDS
//*  STEP020  DFSORT    SORT LOANS
//*  STEP030  DFSORT    SORT REPAYMENTS, REJECT NON-NUMERIC RECORDS
//*  STEP040  DFSORT    SORT ACCOUNT SUMMARIES, REJECT NON-NUMERIC
//*  STEP050  EWSVCUST  VALIDATE CUSTOMERS
//*  STEP055  IDCAMS    LOAD VALID CUSTOMERS INTO VSAM KSDS CUSTKSDS
//*  STEP060  EWSVLOAN  VALIDATE LOANS
//*  STEP070  EWSMATCH  MATCH ALL FILES, BUILD FEATURE RECORDS
//*  STEP080  DFSORT    FEATURE RECORDS -> CSV (FEATCSV)
//*  STEP090  EWSRECON  REXX: RECONCILE COUNTS, WRITE RUNCTL
//*
//*  EVERY STEP AFTER STEP006 RUNS ONLY IF ALL EARLIER STEPS ENDED
//*  WITH RC <= 4, SO BAD DATA NEVER REACHES THE MODEL.
//*-------------------------------------------------------------------
//STEP005  EXEC PGM=IEFBR14
//DEL01    DD DSN=&SYSUID..EWS.CUST.SRT,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL02    DD DSN=&SYSUID..EWS.CUST.DUPS,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL03    DD DSN=&SYSUID..EWS.LOAN.SRT,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL04    DD DSN=&SYSUID..EWS.REPAY.SRT,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL05    DD DSN=&SYSUID..EWS.TXN.SRT,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL06    DD DSN=&SYSUID..EWS.CUST.VALID,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL07    DD DSN=&SYSUID..EWS.LOAN.VALID,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL08    DD DSN=&SYSUID..EWS.REJECTS,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL09    DD DSN=&SYSUID..EWS.EXCEPT,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL10    DD DSN=&SYSUID..EWS.FEATURES,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL11    DD DSN=&SYSUID..EWS.FEATCSV,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL12    DD DSN=&SYSUID..EWS.CTLTOT,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL13    DD DSN=&SYSUID..EWS.RUNCTL,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//*
//STEP006  EXEC PGM=IEFBR14
//REJECTS  DD DSN=&SYSUID..EWS.REJECTS,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//CTLTOT   DD DSN=&SYSUID..EWS.CTLTOT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//*
//IF010    IF (RC <= 4) THEN
//STEP010  EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//IN       DD DSN=&SYSUID..EWS.CUSTMAST,DISP=SHR
//OUT      DD DSN=&SYSUID..EWS.CUST.SRT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(10,10)),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//DUPS     DD DSN=&SYSUID..EWS.CUST.DUPS,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//TOOLIN   DD DSN=&SYSUID..EWS.CNTL(SRTCUST),DISP=SHR
//IF010E   ENDIF
//*
//IF020    IF (RC <= 4) THEN
//STEP020  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..EWS.LOANMAST,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..EWS.LOAN.SRT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(10,10)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD DSN=&SYSUID..EWS.CNTL(SRTLOAN),DISP=SHR
//IF020E   ENDIF
//*
//IF030    IF (RC <= 4) THEN
//STEP030  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..EWS.REPAYHST,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..EWS.REPAY.SRT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(150,50)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//BADREC   DD DSN=&SYSUID..EWS.REJECTS,DISP=MOD
//SYSIN    DD DSN=&SYSUID..EWS.CNTL(SRTREPAY),DISP=SHR
//IF030E   ENDIF
//*
//IF040    IF (RC <= 4) THEN
//STEP040  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..EWS.TXNSUMM,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..EWS.TXN.SRT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(150,50)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//BADREC   DD DSN=&SYSUID..EWS.REJECTS,DISP=MOD
//SYSIN    DD DSN=&SYSUID..EWS.CNTL(SRTTXN),DISP=SHR
//IF040E   ENDIF
//*
//IF050    IF (RC <= 4) THEN
//STEP050  EXEC PGM=EWSVCUST
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//CUSTIN   DD DSN=&SYSUID..EWS.CUST.SRT,DISP=SHR
//CUSTOUT  DD DSN=&SYSUID..EWS.CUST.VALID,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(10,10)),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//REJECTS  DD DSN=&SYSUID..EWS.REJECTS,DISP=MOD
//CTLTOT   DD DSN=&SYSUID..EWS.CTLTOT,DISP=MOD
//SYSOUT   DD SYSOUT=*
//IF050E   ENDIF
//*
//* STEP055: CUSTOMER MASTER AS A VSAM KSDS (KEY = CUSTOMER ID) FOR
//* RANDOM READS BY EWSRPT AND THE OPERATOR LOOKUP. REBUILT EVERY RUN
//* FROM CUST.VALID; THE DELETE MAY FIND NOTHING, SO MAXCC IS RESET.
//IF055    IF (RC <= 4) THEN
//STEP055  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//CUSTIN   DD DSN=&SYSUID..EWS.CUST.VALID,DISP=SHR
//SYSIN    DD *,SYMBOLS=JCLONLY
  DELETE &SYSUID..EWS.CUSTKSDS CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER (NAME(&SYSUID..EWS.CUSTKSDS) -
         INDEXED KEYS(8 0) RECORDSIZE(100 100) -
         TRACKS(15 5) FREESPACE(10 10) SHAREOPTIONS(2 3)) -
         DATA (NAME(&SYSUID..EWS.CUSTKSDS.DATA)) -
         INDEX (NAME(&SYSUID..EWS.CUSTKSDS.INDEX))
  REPRO INFILE(CUSTIN) OUTDATASET(&SYSUID..EWS.CUSTKSDS)
/*
//IF055E   ENDIF
//*
//IF060    IF (RC <= 4) THEN
//STEP060  EXEC PGM=EWSVLOAN
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//LOANIN   DD DSN=&SYSUID..EWS.LOAN.SRT,DISP=SHR
//LOANOUT  DD DSN=&SYSUID..EWS.LOAN.VALID,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(10,10)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//REJECTS  DD DSN=&SYSUID..EWS.REJECTS,DISP=MOD
//CTLTOT   DD DSN=&SYSUID..EWS.CTLTOT,DISP=MOD
//SYSOUT   DD SYSOUT=*
//IF060E   ENDIF
//*
//IF070    IF (RC <= 4) THEN
//STEP070  EXEC PGM=EWSMATCH,PARM='&ASOFDT.&MODE'
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//CUSTIN   DD DSN=&SYSUID..EWS.CUST.VALID,DISP=SHR
//LOANIN   DD DSN=&SYSUID..EWS.LOAN.VALID,DISP=SHR
//REPAYIN  DD DSN=&SYSUID..EWS.REPAY.SRT,DISP=SHR
//TXNIN    DD DSN=&SYSUID..EWS.TXN.SRT,DISP=SHR
//FEATOUT  DD DSN=&SYSUID..EWS.FEATURES,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(15,15)),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=0)
//EXCEPT   DD DSN=&SYSUID..EWS.EXCEPT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//CTLTOT   DD DSN=&SYSUID..EWS.CTLTOT,DISP=MOD
//SYSOUT   DD SYSOUT=*
//IF070E   ENDIF
//*
//IF080    IF (RC <= 4) THEN
//STEP080  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..EWS.FEATURES,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..EWS.FEATCSV,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(15,15)),
//            DCB=(RECFM=VB,LRECL=1024,BLKSIZE=0)
//SYSIN    DD DSN=&SYSUID..EWS.CNTL(FEAT2CSV),DISP=SHR
//IF080E   ENDIF
//*
//IF090    IF (RC <= 4) THEN
//STEP090  EXEC PGM=IKJEFT1B,PARM='%EWSRECON &ASOFDT &MODE'
//SYSEXEC  DD DSN=&SYSUID..EWS.REXX,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD DUMMY
//CUSTIN   DD DSN=&SYSUID..EWS.CUSTMAST,DISP=SHR
//LOANIN   DD DSN=&SYSUID..EWS.LOANMAST,DISP=SHR
//REPAYIN  DD DSN=&SYSUID..EWS.REPAYHST,DISP=SHR
//TXNIN    DD DSN=&SYSUID..EWS.TXNSUMM,DISP=SHR
//CUSTSRT  DD DSN=&SYSUID..EWS.CUST.SRT,DISP=SHR
//CUSTDUP  DD DSN=&SYSUID..EWS.CUST.DUPS,DISP=SHR
//LOANSRT  DD DSN=&SYSUID..EWS.LOAN.SRT,DISP=SHR
//REPAYSRT DD DSN=&SYSUID..EWS.REPAY.SRT,DISP=SHR
//TXNSRT   DD DSN=&SYSUID..EWS.TXN.SRT,DISP=SHR
//REJECTS  DD DSN=&SYSUID..EWS.REJECTS,DISP=SHR
//CTLTOT   DD DSN=&SYSUID..EWS.CTLTOT,DISP=SHR
//FEATOUT  DD DSN=&SYSUID..EWS.FEATURES,DISP=SHR
//RUNCTL   DD DSN=&SYSUID..EWS.RUNCTL,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//IF090E   ENDIF
