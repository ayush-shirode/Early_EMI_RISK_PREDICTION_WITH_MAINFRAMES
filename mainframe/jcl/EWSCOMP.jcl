//EWSCOMP  JOB CLASS=7,MSGLEVEL=(1,1)
//*-------------------------------------------------------------------
//* EWSCOMP - COMPILE AND LINK THE EWS COBOL PROGRAMS
//*   SOURCE    : &SYSUID..CBL(EWSXXXXX)  (SITE PROC IGYWCL, SRC=)
//*   COPYBOOKS : &SYSUID..EWS.CPY        (ADDED AS COBOL.SYSLIB)
//*   LOAD      : &SYSUID..LOAD(EWSXXXXX)
//*-------------------------------------------------------------------
//CVCUST   EXEC IGYWCL,SRC=EWSVCUST
//COBOL.SYSLIB DD DSN=&SYSUID..EWS.CPY,DISP=SHR
//CVLOAN   EXEC IGYWCL,SRC=EWSVLOAN
//COBOL.SYSLIB DD DSN=&SYSUID..EWS.CPY,DISP=SHR
//CMATCH   EXEC IGYWCL,SRC=EWSMATCH
//COBOL.SYSLIB DD DSN=&SYSUID..EWS.CPY,DISP=SHR
//CRPT     EXEC IGYWCL,SRC=EWSRPT
//COBOL.SYSLIB DD DSN=&SYSUID..EWS.CPY,DISP=SHR
