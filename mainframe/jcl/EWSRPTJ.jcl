//EWSRPTJ  JOB CLASS=7,MSGLEVEL=(1,1)
//*-------------------------------------------------------------------
//* EWSRPTJ - PRINT THE EARLY INTERVENTION LIST FROM THE MODEL SCORES
//*           THAT THE BACKEND WROTE BACK TO &SYSUID..EWS.SCORES
//*  STEP005  IEFBR14  DELETE THE PREVIOUS REPORT
//*  STEP006  IDCAMS   DEFINE VSAM KSDS SCORKSDS IF IT IS MISSING
//*  STEP008  EWSSUPD  UPDATE SCORKSDS IN PLACE BY CUSTOMER ID
//*  STEP010  DFSORT   SORT SCORES, HIGHEST RISK FIRST
//*  STEP020  EWSRPT   PRINT REPORT TO EWS.RISKRPT (FBA 133),
//*                    CUSTOMER NAMES READ BY KEY FROM CUSTKSDS
//*-------------------------------------------------------------------
//STEP005  EXEC PGM=IEFBR14
//DEL01    DD DSN=&SYSUID..EWS.SCORES.SRT,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//DEL02    DD DSN=&SYSUID..EWS.RISKRPT,DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(1,1))
//*
//* STEP006: SCORKSDS KEEPS ITS RECORDS FROM RUN TO RUN, SO IT IS
//* ONLY DEFINED WHEN LISTCAT DOES NOT FIND IT.
//STEP006  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *,SYMBOLS=JCLONLY
  LISTCAT ENTRIES(&SYSUID..EWS.SCORKSDS) NAME
  IF LASTCC NE 0 THEN DO
    SET MAXCC = 0
    DEFINE CLUSTER (NAME(&SYSUID..EWS.SCORKSDS) -
           INDEXED KEYS(8 0) RECORDSIZE(100 100) -
           TRACKS(15 5) FREESPACE(20 10) SHAREOPTIONS(2 3)) -
           DATA (NAME(&SYSUID..EWS.SCORKSDS.DATA)) -
           INDEX (NAME(&SYSUID..EWS.SCORKSDS.INDEX))
  END
/*
//*
//IF008    IF (RC = 0) THEN
//STEP008  EXEC PGM=EWSSUPD
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//SCOREIN  DD DSN=&SYSUID..EWS.SCORES,DISP=SHR
//SCOREKS  DD DSN=&SYSUID..EWS.SCORKSDS,DISP=SHR
//SYSOUT   DD SYSOUT=*
//IF008E   ENDIF
//*
//IF010    IF (RC = 0) THEN
//STEP010  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..EWS.SCORES,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..EWS.SCORES.SRT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(5,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD DSN=&SYSUID..EWS.CNTL(SRTSCORE),DISP=SHR
//IF010E   ENDIF
//*
//IF020    IF (STEP010.RC = 0) THEN
//STEP020  EXEC PGM=EWSRPT
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//SCOREIN  DD DSN=&SYSUID..EWS.SCORES.SRT,DISP=SHR
//CUSTKS   DD DSN=&SYSUID..EWS.CUSTKSDS,DISP=SHR
//RPTOUT   DD DSN=&SYSUID..EWS.RISKRPT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSALLDA,SPACE=(TRK,(10,10)),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//IF020E   ENDIF
